loadaddr=0x90000000
bootdelay=3
xg2010g_debug_prompt=0
bootconf=config-1
bootargs=console=ttyS0,115200 earlycon ubi.block=0,fit root=/dev/fit0 rootwait
boot_ubi=ubi part ubi && run omci_boot_guard && run boot_production
boot_stock=xg2010g_load tclinux_slave ${loadaddr} && bootm ${loadaddr}
boot_production=run ubi_read_production && bootm ${loadaddr}#${bootconf}
bootcmd=run boot_ubi || run boot_stock || http_recovery
ubi_read_production=ubi read ${loadaddr} fit
rootfs_data_max=0x15800000
omci_active_id=0
omci_committed_id=0
omci_rollback=if ubi check omci_fit_old; then if ubi check fit; then if ubi check omci_fit_failed; then ubi remove omci_fit_failed; fi; ubi rename fit omci_fit_failed; fi; ubi rename omci_fit_old fit; fi; if ubi check fit; then if ubi check omci_fit_failed; then ubi remove omci_fit_failed; fi; setenv omci_active_id ${omci_committed_id}; setenv omci_pending; saveenv; else false; fi
omci_boot_commit=if ubi check fit; then if ubi check omci_fit_switch; then run omci_boot_finish; elif ubi check omci_fit_${omci_active_id}; then setenv omci_active_id ${omci_committed_id}; saveenv; else if ubi rename fit omci_fit_switch; then run omci_boot_finish; else false; fi; fi; elif ubi check omci_fit_switch; then run omci_boot_finish; else false; fi
omci_boot_finish=if ubi check fit; then run omci_boot_stage; elif ubi check omci_fit_old; then if ubi rename omci_fit_old fit; then run omci_boot_stage; else false; fi; elif ubi check omci_fit_${omci_committed_id}; then if ubi rename omci_fit_${omci_committed_id} fit; then run omci_boot_stage; else false; fi; else false; fi
omci_boot_stage=if ubi check omci_fit_switch; then if ubi check omci_fit_${omci_active_id}; then if ubi remove omci_fit_${omci_active_id}; then ubi rename omci_fit_switch omci_fit_${omci_active_id}; else false; fi; else ubi rename omci_fit_switch omci_fit_${omci_active_id}; fi; fi; if ubi check fit; then if ubi check omci_fit_${omci_active_id}; then setenv omci_active_id ${omci_committed_id}; saveenv; else false; fi; else false; fi
omci_boot_guard=if test "${omci_pending}" = "1"; then setenv omci_pending 2; saveenv; elif test "${omci_pending}" = "prepare"; then run omci_rollback; elif test "${omci_pending}" = "2"; then if test "${omci_active_id}" = "${omci_committed_id}"; then setenv omci_pending; saveenv; else run omci_rollback; fi; elif test "${omci_active_id}" != "${omci_committed_id}"; then run omci_boot_commit; else true; fi
recovery_addr=0x90000000
recovery_mtd=fit
recovery_ubi_part=ubi
recovery_firmware_fit_offset=0
recovery_dev_uboot=spi-nand0
uboot_ofs=0x600000
recovery_size_uboot=0x100000
rtl8261_patch_autoload=1
