loadaddr=0x90000000
boot_stock=xg2010g_load tclinux_slave ${loadaddr} && bootm ${loadaddr}
bootcmd=run boot_stock || http_recovery
recovery_addr=0x90000000
recovery_dev=tclinux_slave
recovery_ofs=0
recovery_size=0x4000000
recovery_firmware_fit_offset=0x2100
recovery_dev_uboot=tclinux
uboot_ofs=0
recovery_size_uboot=0x100000
